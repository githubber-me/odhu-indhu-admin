# Neon Postgres and Neon Auth
DATABASE_URL=
NEON_AUTH_BASE_URL=

# One verified administrator email, or a comma-separated allowlist.
ACCESS_EMAIL=

# At least 32 characters. CRON_SECRET is used as a fallback when omitted.
NEON_AUTH_COOKIE_SECRET=
CRON_SECRET=

# Private Vercel Blob store used for weekly learner voice notes.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
